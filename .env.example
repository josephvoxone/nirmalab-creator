# Copy to .env (or pass with -e) and fill in what you use. Nothing here is required to boot
# the app except the admin bootstrap pair.

# --- bootstrap ---------------------------------------------------------------
OPENCREATOR_DATA_DIR=/data          # where auth, stories, keys and job state live
OPENCREATOR_PUBLIC_URL=http://localhost:3000
OPENCREATOR_ADMIN_EMAIL=you@example.com
OPENCREATOR_ADMIN_PASSWORD=change-me

# --- server ------------------------------------------------------------------
PORT=3000
STORY_PYTHON=python3
STORY_ASSEMBLER=/app/bridge/py/assemble.py
MEDIA_FFMPEG=ffmpeg                 # must have libass + libwebp
APP_VERSION=dev

# --- keys (optional; a signed-in admin can also set these in Pengaturan) -----
ELEVENLABS_API_KEYS=                # comma separated, dubbing
GEMINI_API_KEYS=                    # comma separated, text models
OPENCREATOR_POLLINATIONS_API_KEY=   # keyless fallback for drafting

# --- publishing (optional) ---------------------------------------------------
OPENCREATOR_PUBLISHER_YOUTUBE_CLIENT_ID=
OPENCREATOR_PUBLISHER_YOUTUBE_CLIENT_SECRET=
OPENCREATOR_PUBLISHER_TIKTOK_CLIENT_KEY=
OPENCREATOR_PUBLISHER_TIKTOK_CLIENT_SECRET=
OPENCREATOR_PUBLISHER_META_APP_ID=
OPENCREATOR_PUBLISHER_META_APP_SECRET=

# --- Google Flow bridge (optional, see deploy/flow-bridge) -------------------
FLOW_BRIDGE_TOKEN=change-me
CREATOR_URL=http://localhost:3000
FLOW_CDP_URL=http://127.0.0.1:9333
FLOW_MAX_CREDITS=20
FLOW_RESOLUTION=720
